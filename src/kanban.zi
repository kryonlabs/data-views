// A cell is a configured instance of the same Kanban, with caller-owned data.
// This module owns column layout, clipping, scroll state, card gestures and
// the typed widget props for every frame. The kryon TSX composition surface
// owns the Box/Text/Scroll component calls with their Scoped children.
Box :: #import "kryon/box";
Scroll :: #import "kryon/scroll";
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "std/number_text"


KanbanLaneLimit :: 8;
KanbanCardLimit :: 6000;
KanbanConfig :: struct {
    key: u64
    lane_count: s32
    min_width: float32
    gap: float32
    background: Color
    card_background: Color
    drag_background: Color
    header_font: s32
}
KanbanCell :: struct {
    horizontal: s32; max_horizontal: s32
    offsets: [KanbanLaneLimit]s32; maxima: [KanbanLaneLimit]s32
    columns: [KanbanLaneLimit]Rectangle
    inputs: [KanbanLaneLimit + 1]Scroll.ScrollInput
    hits: [KanbanCardLimit]Rectangle; identities: [KanbanCardLimit]u64; hit_count: s32
    pressed: u64; dragging: bool; start: Vector2; point: Vector2
    wheel_target: s32; wheel_remainder: float32
}
KanbanInput :: struct {
    explicit: bool; disabled: bool
    mouse: Vector2; down: bool; pressed: bool; released: bool
    now: float64
}
KanbanFrame :: struct {
    config: KanbanConfig; bounds: Rectangle; width: float32
    strip_offset: s32
    input: KanbanInput
}
KanbanColumnFrame :: struct {
    visible: bool; lane: s32
    bounds: Rectangle; header: Rectangle; clip: Rectangle
    title_key: u64
    content_height: s32; y: float32; card_width: float32
}
KanbanGesture :: struct { consumed: bool; identity: u64; lane: s32; moved: bool; }
KanbanCardSlot :: struct { bounds: Rectangle; column: KanbanColumnFrame }

// Vanilla defaults. Each caller changes only configuration and card content.
#program_export
KanbanDefaults :: (key: u64, lanes: s32 = 3) -> KanbanConfig {
    result: KanbanConfig; result.key=key; result.lane_count=lanes
    result.min_width=280.0; result.gap=12.0; result.header_font=15
    result.background=.{20,33,45,255}; result.card_background=.{28,41,54,255}; result.drag_background=.{45,80,110,255}
    return result
}
#program_export
KanbanContains :: (bounds: Rectangle, point: Vector2) -> bool {
    return bounds.width>0.0 && bounds.height>0.0 && point.x>=bounds.x && point.x<bounds.x+bounds.width && point.y>=bounds.y && point.y<bounds.y+bounds.height
}
#program_export
KanbanIntersect :: (first: Rectangle, second: Rectangle) -> Rectangle {
    x:=ifx first.x>second.x then first.x else second.x; y:=ifx first.y>second.y then first.y else second.y
    right:=ifx first.x+first.width<second.x+second.width then first.x+first.width else second.x+second.width
    bottom:=ifx first.y+first.height<second.y+second.height then first.y+first.height else second.y+second.height
    if right<=x || bottom<=y { return .{} }; return .{x,y,right-x,bottom-y}
}
#program_export
KanbanClamp :: (value: s32, maximum: s32) -> s32 { return ifx value<0 then 0 else ifx value>maximum then maximum else value }
#program_export
KanbanScrollObservation :: (cell: *KanbanCell, index: s32, bounds: Rectangle, horizontal: bool, input: KanbanInput) -> Scroll.ScrollInput {
    if !input.explicit { return .{} }
    result:=cell.inputs[index]; result.enabled=true; result.disabled=input.disabled
    result.mouse=input.mouse; result.down=input.down; result.pressed=input.pressed; result.released=input.released; result.now_seconds=input.now
    track:=bounds
    if horizontal { track.y+=track.height-14.0; track.height=14.0 } else { track.x+=track.width-14.0; track.width=14.0 }
    result.pointer_allowed=!input.disabled && (result.owns_drag || KanbanContains(track,input.mouse))
    return result
}
#program_export
BeginKanban :: (cell: *KanbanCell, config: KanbanConfig, bounds: Rectangle, input: KanbanInput) -> KanbanFrame {
    frame: KanbanFrame; frame.config=config; frame.bounds=bounds; frame.input=input
    frame.strip_offset=cell.horizontal
    if config.lane_count<1 || config.lane_count>KanbanLaneLimit { frame.config.lane_count=0; return frame }
    frame.width=(bounds.width-cast(float32)(config.lane_count-1)*config.gap)/cast(float32)config.lane_count
    if frame.width<config.min_width { frame.width=config.min_width }
    for i: 0..cast(s32)KanbanLaneLimit-1 { cell.columns[i]=.{} }
    for i: 0..cell.hit_count-1 { cell.hits[i]=.{}; cell.identities[i]=0 }; cell.hit_count=0
    return frame
}
// The TSX composition submits these props to the Strip Scroll component and
// applies the returned view before drawing the lanes inside its children.
#program_export
KanbanStripProps :: (cell: *KanbanCell, frame: KanbanFrame) -> Scroll.Props {
    props: Scroll.Props; props.key=frame.config.key; props.bounds=frame.bounds; props.horizontal=true
    props.content_width=cast(s32)(frame.width*cast(float32)frame.config.lane_count+cast(float32)(frame.config.lane_count-1)*frame.config.gap)
    props.scroll_offset=cell.horizontal; props.input=KanbanScrollObservation(cell,0,frame.bounds,true,frame.input)
    return props
}
#program_export
KanbanStripApplied :: (cell: *KanbanCell, frame: KanbanFrame, view: Scroll.ScrollResult) {
    cell.horizontal=view.scroll_offset; cell.max_horizontal=view.max_scroll
    if frame.input.explicit { cell.inputs[0]=Scroll.ScrollInputAfter(KanbanStripProps(cell,frame).input,view.frame) }
}
// Pure strip view application. The composition calls this inside the Scroll
// children so the lanes position by exactly the offset the container kept;
// the returned frame value is what application children receive.
#program_export
KanbanFrameApplied :: (frame: KanbanFrame, view: Scroll.ScrollResult) -> KanbanFrame {
    result:=frame; result.strip_offset=view.scroll_offset; return result
}
// Caption scratch shared by the drawing phase; the returned view backs on
// module storage, so it stays valid for the TSX Text component call.
caption_buffer: [160]u8;
#program_export
KanbanCaption :: (title: string, count: s32) -> string {
    number: [32]u8; digits:=FormatInteger(cast(s64)count,number[:]); at: s32
    for byte: title { if at>=120 { break }; caption_buffer[at]=byte; at+=1 }
    caption_buffer[at]=cast(u8)32; at+=1; caption_buffer[at]=cast(u8)40; at+=1
    for byte: digits { caption_buffer[at]=byte; at+=1 }
    caption_buffer[at]=cast(u8)41; at+=1
    return TextView(caption_buffer[:at])
}
#program_export
KanbanColumn :: (cell: *KanbanCell, frame: KanbanFrame, lane: s32, title: string, count: s32, content_height: s32) -> KanbanColumnFrame {
    result: KanbanColumnFrame; result.lane=lane
    if lane<0 || lane>=frame.config.lane_count { return result }
    result.bounds=.{frame.bounds.x+cast(float32)lane*(frame.width+frame.config.gap)-cast(float32)frame.strip_offset,frame.bounds.y,frame.width,frame.bounds.height-14.0}
    visible:=KanbanIntersect(result.bounds,frame.bounds); if visible.width<=0.0 { return result }
    result.visible=true
    result.title_key=frame.config.key+20+cast(u64)lane
    result.header=.{result.bounds.x+14.0,result.bounds.y+10.0,frame.width-28.0,28.0}
    result.content_height=content_height
    view_bounds: Rectangle=.{result.bounds.x+8.0,result.bounds.y+48.0,frame.width-16.0,result.bounds.height-56.0}
    result.clip=KanbanIntersect(view_bounds,visible); cell.columns[lane]=result.clip
    result.y=0.0; result.card_width=frame.width-36.0
    return result
}
// Typed chrome props for the TSX composition: the column background, the
// caption label and the vertical card view.
#program_export
KanbanColumnBoxProps :: (column: *KanbanColumnFrame, config: KanbanConfig) -> Box.Props {
    box: Box.Props; box.key=config.key+10+cast(u64)column.lane; box.bounds=column.bounds; box.fill=config.background; box.radius=10.0
    return box
}
#program_export
KanbanColumnViewProps :: (cell: *KanbanCell, frame: KanbanFrame, column: *KanbanColumnFrame) -> Scroll.Props {
    props: Scroll.Props; props.key=frame.config.key+100+cast(u64)column.lane
    props.bounds=.{column.bounds.x+8.0,column.bounds.y+48.0,frame.width-16.0,column.bounds.height-56.0}
    props.content_height=column.content_height; props.scroll_offset=cell.offsets[column.lane]; props.input=KanbanScrollObservation(cell,column.lane+1,props.bounds,false,frame.input)
    return props
}
// Pure column placement. The composition calls this inside the view's Scoped
// children so cards stack from the same origin the container reported; the
// returned value is what application children receive.
#program_export
KanbanColumnPlaced :: (column: KanbanColumnFrame, view: Scroll.ScrollResult) -> KanbanColumnFrame {
    result:=column; result.y=view.content.y+4.0; return result
}
#program_export
KanbanColumnApplied :: (cell: *KanbanCell, frame: KanbanFrame, column: *KanbanColumnFrame, view: Scroll.ScrollResult) {
    cell.offsets[column.lane]=view.scroll_offset; cell.maxima[column.lane]=view.max_scroll
    if frame.input.explicit { cell.inputs[column.lane+1]=Scroll.ScrollInputAfter(KanbanColumnViewProps(cell,frame,column).input,view.frame) }
}
#program_export
KanbanCard :: (cell: *KanbanCell, frame: KanbanFrame, column: KanbanColumnFrame, index: s32, identity: u64, height: float32) -> KanbanCardSlot {
    bounds: Rectangle=.{column.bounds.x+12.0,column.y,column.card_width,height-8.0}; column.y+=height
    result: KanbanCardSlot; result.column=column
    hit:=KanbanIntersect(bounds,column.clip); if hit.width<=0.0 || hit.height<=0.0 { return result }
    if index>=0 && index<KanbanCardLimit { cell.hits[index]=hit; cell.identities[index]=identity; if index>=cell.hit_count { cell.hit_count=index+1 } }
    result.bounds=bounds; return result
}
#program_export
KanbanCardBoxProps :: (cell: *KanbanCell, frame: KanbanFrame, bounds: Rectangle, identity: u64) -> Box.Props {
    box: Box.Props; box.key=identity ^ (frame.config.key+200); box.bounds=bounds; box.radius=8.0
    box.fill=ifx cell.dragging && cell.pressed==identity then frame.config.drag_background else frame.config.card_background
    return box
}
#program_export
ResetKanban :: (cell: *KanbanCell) { cell.horizontal=0; cell.max_horizontal=0; CancelKanban(cell); cell.wheel_remainder=0.0; for i: 0..cast(s32)KanbanLaneLimit-1 { cell.offsets[i]=0; cell.maxima[i]=0; cell.columns[i]=.{} }; for i: 0..cast(s32)KanbanLaneLimit { cell.inputs[i]=.{} } }
#program_export
CancelKanban :: (cell: *KanbanCell) { cell.pressed=0; cell.dragging=false }
#program_export
PanKanban :: (cell: *KanbanCell, delta: s32) { cell.horizontal=KanbanClamp(cell.horizontal+delta,cell.max_horizontal) }
#program_export
WheelKanban :: (cell: *KanbanCell, point: Vector2, delta: float32, horizontal: bool = false) -> bool {
    lane: s32=-1
    for i: 0..cast(s32)KanbanLaneLimit-1 { if KanbanContains(cell.columns[i],point) { lane=i; break } }
    if lane<0 && !horizontal { return false }
    target:=ifx horizontal then -1 else lane+1
    if cell.wheel_target!=target { cell.wheel_target=target; cell.wheel_remainder=0.0 }
    distance:=delta*(ifx horizontal then 72.0 else 48.0)+cell.wheel_remainder; steps:=cast(s32)distance; cell.wheel_remainder=distance-cast(float32)steps
    if horizontal { cell.horizontal=KanbanClamp(cell.horizontal-steps,cell.max_horizontal) }
    else { cell.offsets[lane]=KanbanClamp(cell.offsets[lane]-steps,cell.maxima[lane]) }
    return true
}
#program_export
PointerKanban :: (cell: *KanbanCell, bounds: Rectangle, lanes: s32, point: Vector2, down: bool, pressed: bool, released: bool) -> KanbanGesture {
    result: KanbanGesture; result.lane=-1; cell.point=point
    if pressed {
        CancelKanban(cell)
        for i: 0..cell.hit_count-1 { if cell.identities[i]!=0 && KanbanContains(cell.hits[i],point) { cell.pressed=cell.identities[i]; cell.start=point; result.consumed=true; return result } }
    }
    if cell.pressed==0 { return result }; result.consumed=true
    dx:=point.x-cell.start.x; dy:=point.y-cell.start.y
    if down && dx*dx+dy*dy>64.0 { cell.dragging=true }
    if cell.dragging && down {
        if point.x<bounds.x+18.0 { PanKanban(cell,-12) }; if point.x>bounds.x+bounds.width-18.0 { PanKanban(cell,12) }
        for lane: 0..lanes-1 { if KanbanContains(cell.columns[lane],point) { if point.y<cell.columns[lane].y+32.0 { cell.offsets[lane]=KanbanClamp(cell.offsets[lane]-12,cell.maxima[lane]) }; if point.y>cell.columns[lane].y+cell.columns[lane].height-22.0 { cell.offsets[lane]=KanbanClamp(cell.offsets[lane]+12,cell.maxima[lane]) } } }
    }
    if released { result.identity=cell.pressed; result.moved=cell.dragging; for lane: 0..lanes-1 { if KanbanContains(cell.columns[lane],point) { result.lane=lane; break } }; CancelKanban(cell) }
    return result
}
