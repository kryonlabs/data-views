#import "kryon/geometry"

TableRow :: struct { cells: []string }

// Borrowed slices stay in the app. The result carries state between frames;
// column_widths may be updated by a resize gesture.
TableViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    columns: []string
    rows: []TableRow
    column_widths: []s32
    selected_row: s32
    selected_column: s32
    sort_column: s32
    sort_direction: s32
    scroll_offset: s32
    row_height: s32
    column_enabled: []bool
    column_order: []s32
    disabled: bool
    resizable: bool
    min_column_width: s32
    freeze_rows: s32
    header_height: s32
}

TableViewResult :: struct {
    node: s32
    selected_row: s32
    selected_column: s32
    sort_column: s32
    sort_direction: s32
    scroll_offset: s32
    activated_row: s32
    activated_column: s32
    changed: bool
}
