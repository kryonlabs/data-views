#import "kryon/geometry"

TableRow :: struct { cells: []string }

// Borrowed slices stay in the app. The result carries state between frames;
// column_widths may be updated by a resize gesture.
TableViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    columns: []string
    rows: []TableRow
    column_widths: []s32
    selected_row: s32
    selected_column: s32
    sort_column: s32
    sort_direction: s32
    scroll_offset: s32
    row_height: s32
    column_enabled: []bool
    column_order: []s32
    disabled: bool
    resizable: bool
    min_column_width: s32
    freeze_rows: s32
    header_height: s32
    // Opt in: selection must have exactly one mutable flag per row.
    multi_select: bool
    selection: []bool
    focused_row: s32 // -1 means no row cursor
    anchor: s32 // -1 starts a range at the current focus
}

TableViewResult :: struct {
    node: s32
    selected_row: s32
    selected_column: s32
    sort_column: s32
    sort_direction: s32
    scroll_offset: s32
    activated_row: s32
    activated_column: s32
    clicked_row: s32 // accepted cell click, including unchanged selection
    clicked_column: s32
    changed: bool
    // Multi-row state; selection borrows the caller's original slice.
    selection: []bool
    selected_count: s32
    selection_changed: bool // flags were mutated by this call
    focused_row: s32
    anchor: s32
    focus_changed: bool // row cursor moved during this call
    selection_valid: bool // multi mode with exactly one flag per row
}
