#import "kryon/geometry"

TreeItem :: struct {
    label: string
    depth: s32
    id: s32
    expanded: bool
    selectable: bool
    // False preserves disclosure behavior; true hides the marker and disables toggles.
    leaf: bool
}

TreeViewNavigation :: enum {
    TreeViewNavigationNone :: 0
    TreeViewNavigationHome :: 1
    TreeViewNavigationEnd :: 2
    TreeViewNavigationUp :: 3
    TreeViewNavigationDown :: 4
    TreeViewNavigationLeft :: 5
    TreeViewNavigationRight :: 6
}

// Items are a borrowed slice passed to TreeView, not a pointer in this record.
// The caller stores the returned selection and scroll value between frames.
TreeViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    selected_id: s32
    scroll_offset: s32
    scroll_delta: s32
    row_height: s32
    scale: float32
    focused: bool
    navigation: TreeViewNavigation
    disabled: bool
    // Caller-owned logical pixels; supply wheel/pan input as a delta.
    horizontal_offset: s32
    horizontal_delta: s32
    // One-call programmatic reveal; leave false while manually scrolling.
    reveal_selected: bool
}

TreeViewResult :: struct {
    node: s32
    selected_id: s32
    scroll_offset: s32
    changed: bool
    // Per-call positive item identities; zero means no event.
    activated_id: s32
    toggled_id: s32
    horizontal_offset: s32
    horizontal_max_scroll: s32
}
