#import "kryon/session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "kryon/geometry"
#import "kryon/paint_queue"
#import "kryon/semantic"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/style_sheet"
#import "kryon/control_props"
#import "tree_view"
#import "tree_view_props"
#import "kryon/widget_kind"
#import "tree_view_host"

using SemanticKind;
using TreeViewNavigation;
using WidgetKind;

phase: s32;
selected: s32;
scroll: s32;

#program_export
Frame :: () -> s32 {
    items: [3]TreeItem
    items[0] = TreeItem.{"First", 0, 1, false, true}
    items[1] = TreeItem.{"Second", 1, 2, true, true}
    items[2] = TreeItem.{"Third", 2, 3, false, true}
    if phase == 8 { items[1].selectable = false }
    props: TreeViewProps
    props.key = cast(u64)20
    props.bounds = Rectangle.{10.0, 10.0, 120.0, 48.0}
    props.row_height = 20
    props.selected_id = selected
    props.scroll_offset = scroll
    if phase == 0 { props.selected_id = 1 }
    if phase == 1 { props.scroll_delta = 12 }
    if phase == 2 {
        props.disabled = true
        props.scroll_delta = 100
    }
    if phase == 3 { props.scroll_offset = 0 }
    if phase >= 6 { props.focused = true }
    if phase == 6 || phase == 8 {
        props.navigation = cast(TreeViewNavigation)TreeViewNavigationUp
    }
    if phase == 7 { props.navigation = cast(TreeViewNavigation)TreeViewNavigationEnd }
    if phase == 9 {
        props.navigation = cast(TreeViewNavigation)TreeViewNavigationHome
        props.disabled = true
    }
    if phase == 10 {
        props.navigation = cast(TreeViewNavigation)TreeViewNavigationDown
    }
    if phase == 11 {
        props.navigation = cast(TreeViewNavigation)TreeViewNavigationHome
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 160.0, 100.0})
    result: TreeViewResult = TreeView(TestSession(), props, items[0:3])
    if !TreeFinish(TestSession()) || TreeCount(TestSession()) != 10 || result.node != 1 ||
        TreeNodeAt(TestSession(), 1).semantic_kind != cast(SemanticKind)SemanticTree ||
        TreeNodeAt(TestSession(), 4).semantic_kind != cast(SemanticKind)SemanticTreeItem ||
        TreeNodeAt(TestSession(), 4).semantic_label != "Second" ||
        TreeNodeAt(TestSession(), 9).kind != WidgetKindSlider { return -10 }
    if phase == 0 {
        if result.selected_id != 1 || result.changed ||
            result.scroll_offset != 0 ||
            TreeNodeAt(TestSession(), 6).bounds.height != 8.0 ||
            TreeHitAt(TestSession(), 20.0, 59.0) != -1 { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 35.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 35.0, false, false, true})
    } else if phase == 1 {
        if result.selected_id != 2 || !result.changed ||
            result.scroll_offset != 12 ||
            TreeNodeAt(TestSession(), 2).bounds.y != 10.0 ||
            TreeNodeAt(TestSession(), 2).bounds.height != 8.0 ||
            TreeHitAt(TestSession(), 20.0, 9.0) != -1 { return -2 }
    } else if phase == 2 {
        if result.selected_id != 2 || result.changed ||
            result.scroll_offset != 12 ||
            TreeHitAt(TestSession(), 20.0, 25.0) != -1 { return -3 }
    } else if phase == 3 {
        if result.selected_id != 2 || result.scroll_offset != 0 ||
            TreeNodeAt(TestSession(), 9).bounds.y != 10.0 ||
            TreeHitAt(TestSession(), 126.0, 20.0) != 9 { return -4 }
        TreePointerUpdate(TestSession(), PointerFrame.{126.0, 20.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{126.0, 40.0, true, false, false})
    } else if phase == 4 {
        // The proportional thumb is 38px in this 48px viewport. A 20px
        // drag reaches the 12px maximum; releasing farther stays clamped.
        if result.selected_id != 2 || result.scroll_offset != 12 ||
            result.changed {
            print("TreeView drag: selected=% scroll=% changed=%\n", result.selected_id, result.scroll_offset, result.changed)
            return -5
        }
        TreePointerUpdate(TestSession(), PointerFrame.{126.0, 45.0, false, false, true})
    } else if phase == 5 {
        if result.selected_id != 2 || result.scroll_offset != 12 ||
            result.changed { return -6 }
    } else if phase == 6 {
        if result.selected_id != 1 || result.scroll_offset != 0 ||
            !result.changed { return -7 }
    } else if phase == 7 {
        if result.selected_id != 3 || result.scroll_offset != 12 ||
            !result.changed { return -8 }
    } else if phase == 8 {
        if result.selected_id != 1 || result.scroll_offset != 0 ||
            !result.changed { return -9 }
    } else if phase == 9 {
        if result.selected_id != 1 || result.scroll_offset != 0 ||
            result.changed { return -11 }
    } else if phase == 10 {
        if result.selected_id != 2 || result.scroll_offset != 0 ||
            !result.changed { return -12 }
    } else {
        if result.selected_id != 1 || result.scroll_offset != 0 ||
            !result.changed { return -13 }
    }
    PaintFlush(TestSession())
    selected = result.selected_id
    scroll = result.scroll_offset
    old: s32 = phase
    phase += 1
    return old
}

#program_export
main :: () -> s32 {
    TreeViewHostBounds(Rectangle.{10.0, 10.0, 120.0, 48.0})
    index: s32 = 0
    while index < 12 {
        if Frame() != index || TreeViewHostFailed() ||
            TreeViewLabelCount() != (index + 1) * 6 { return 1 }
        index += 1
    }
    if TreeViewFillCount() < 6 { return 2 }
    events := TreeEvents()
    if events != 0 { return events }
    return TreeHorizontal()
}

// Every event assertion runs the actual retained widget and raster host.
EventFrame :: (props: TreeViewProps, items: []TreeItem) -> TreeViewResult {
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 160.0, 100.0})
    result := TreeView(TestSession(), props, items)
    if !TreeFinish(TestSession()) { result.node = -1 }
    PaintFlush(TestSession())
    return result
}

EventClick :: (x: float32, y: float32) {
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, true, true, false})
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, false, false, true})
}

EventIs :: (r: TreeViewResult, selected_id: s32, activated: s32,
    toggled: s32, changed: bool) -> bool {
    return r.node >= 0 && r.selected_id == selected_id &&
        r.activated_id == activated && r.toggled_id == toggled &&
        r.changed == changed && !TreeViewHostFailed()
}

TreeEvents :: () -> s32 {
    items: [3]TreeItem
    items[0] = TreeItem.{"Parent", 0, 101, false, true}
    items[1] = TreeItem.{"Child", 1, 202, false, true}
    items[2] = TreeItem.{"Grandchild", 2, 303, false, true}
    p: TreeViewProps
    p.key = cast(u64)200
    p.bounds = Rectangle.{10.0, 10.0, 120.0, 48.0}
    p.row_height = 20
    p.selected_id = 202
    r := EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 20 }
    // Marker wins over the whole-row hit, without selecting the parent.
    if TreeHitAt(TestSession(), 20.0, 15.0) != 3 { return 21 }
    EventClick(20.0, 15.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 101, false) { return 22 }
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 23 }
    EventClick(100.0, 35.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 202, 0, false) { return 24 }
    EventClick(100.0, 15.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 101, 0, true) { return 25 }
    // Scrolled marker/row regions are clipped on both viewport edges.
    p.scroll_offset = 12
    r = EventFrame(p, items[:])
    if TreeNodeAt(TestSession(), 3).bounds.height != 8.0 ||
        TreeHitAt(TestSession(), 20.0, 9.0) != -1 ||
        TreeHitAt(TestSession(), 60.0, 59.0) != -1 { return 26 }
    EventClick(20.0, 11.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 101, false) { return 27 }
    EventClick(100.0, 11.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 101, 0, true) { return 28 }
    EventClick(20.0, 9.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 29 }
    p.disabled = true
    r = EventFrame(p, items[:])
    EventClick(20.0, 11.0)
    p.focused = true
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationRight
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 30 }
    p.disabled = false
    p.focused = false
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 31 }
    p.focused = true
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 202, false) { return 32 }
    items[1].expanded = true
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 0, 0, true) || r.scroll_offset != 12 { return 33 }
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationLeft
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 202, false) { return 34 }
    items[1].expanded = false
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 0, 0, true) || r.scroll_offset != 0 { return 35 }
    items[0].selectable = false
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 36 }
    items[1].selectable = false
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationRight
    r = EventFrame(p, items[:])
    EventClick(40.0, 25.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 37 }
    // A pending row release follows its stable ID across reordering.
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationNone
    items[0].selectable = true
    items[1].selectable = true
    r = EventFrame(p, items[:])
    EventClick(100.0, 11.0)
    swap := items[0]
    items[0] = items[1]
    items[1] = swap
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 101, 0, true) { return 38 }
    // Nonpositive IDs retain legacy selection, but never become event IDs.
    items[0].id = -7
    r = EventFrame(p, items[:])
    EventClick(100.0, 11.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, -7, 0, 0, true) { return 39 }
    EventClick(40.0, 11.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 0, false) { return 40 }
    // Marker identity also follows a row across reordering.
    items[0] = TreeItem.{"Parent", 0, 101, true, true}
    items[1] = TreeItem.{"Child", 1, 202, false, true}
    items[2] = TreeItem.{"Grandchild", 2, 303, false, true}
    p.selected_id = 202
    r = EventFrame(p, items[:])
    EventClick(20.0, 11.0)
    swap = items[0]
    items[0] = items[1]
    items[1] = swap
    r = EventFrame(p, items[:])
    if !EventIs(r, 202, 0, 101, false) { return 44 }
    items[0] = TreeItem.{"Parent", 0, 101, true, true}
    items[1] = TreeItem.{"Child", 1, 202, true, false}
    p.selected_id = 101
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationRight
    r = EventFrame(p, items[:])
    // A grandchild is not a substitute for an ineligible direct child.
    if !EventIs(r, 101, 0, 0, false) { return 45 }
    p.selected_id = 303
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationLeft
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 0, 0, false) { return 46 }
    p.selected_id = 999
    r = EventFrame(p, items[:])
    if !EventIs(r, 999, 0, 0, false) { return 47 }
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationRight
    r = EventFrame(p, items[:])
    if !EventIs(r, 999, 0, 0, false) { return 48 }
    items[1].selectable = true
    items[0] = TreeItem.{"Leaf", 0, 101, true, true}
    items[0].leaf = true
    p.selected_id = 101
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationRight
    labels_before := TreeViewLabelCount()
    r = EventFrame(p, items[:])
    if TreeViewLabelCount() != labels_before + 5 { return 49 }
    if !EventIs(r, 101, 0, 0, false) ||
        TreeHitAt(TestSession(), 20.0, 11.0) != 2 { return 41 }
    EventClick(20.0, 11.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 101, 0, false) { return 42 }
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationLeft
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 0, 0, false) { return 43 }
    return 0
}

TreeHorizontal :: () -> s32 {
    items: [3]TreeItem
    items[0] = TreeItem.{"Root", 0, 101, true, true}
    items[1] = TreeItem.{"Middle", 7, 202, true, true}
    items[2] = TreeItem.{"DeepEight", 8, 303, false, true}
    p: TreeViewProps
    p.key = cast(u64)300
    p.bounds = Rectangle.{10.0, 10.0, 150.0, 48.0}
    TreeViewHostBounds(p.bounds)
    p.row_height = 20
    p.selected_id = 101
    r := EventFrame(p, items[:])
    // Extent = indent 152 + marker 16 + gap 2 + text 63 + trailing 8.
    // Usable viewport excludes the 8px vertical bar.
    if r.horizontal_max_scroll != 99 || r.horizontal_offset != 0 ||
        !EventIs(r, 101, 0, 0, false) { return 50 }
    // Caller-supplied wheel/pan deltas work simultaneously on both axes.
    p.horizontal_delta = 99
    p.scroll_delta = 12
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 99 || r.scroll_offset != 12 ||
        !TreeViewDeepReadable() || !EventIs(r, 101, 0, 0, false) { return 51 }
    p.horizontal_offset = r.horizontal_offset
    p.scroll_offset = r.scroll_offset
    p.horizontal_delta = 0
    p.scroll_delta = 0
    // Deep marker now occupies x=63..79, bottom row y=38..58.
    hit := TreeHitAt(TestSession(), 65.0, 45.0)
    if hit < 0 { return 52 }
    if TreeNodeAt(TestSession(), hit).bounds.x != 63.0 ||
        TreeNodeAt(TestSession(), hit).bounds.width != 16.0 ||
        TreeHitAt(TestSession(), 65.0, 59.0) != -1 { return 52 }
    EventClick(65.0, 45.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 101, 0, 303, false) { return 53 }
    EventClick(90.0, 45.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 303, 0, true) { return 54 }
    p.selected_id = 303
    EventClick(90.0, 45.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 303, 0, false) { return 55 }
    p.horizontal_offset = 0
    p.scroll_offset = 0
    p.focused = true
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationEnd
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 99 || r.scroll_offset != 12 ||
        !TreeViewDeepReadable() || !EventIs(r, 303, 0, 0, false) { return 56 }
    // Explicit programmatic reveal works with navigation=None and no event.
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationNone
    p.reveal_selected = true
    TreeViewHostBounds(p.bounds)
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 99 || r.scroll_offset != 12 ||
        !TreeViewDeepReadable() || !EventIs(r, 303, 0, 0, false) { return 69 }
    p.reveal_selected = false
    // Idle calls preserve a manual pan, even when selection remains deep.
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationNone
    p.horizontal_offset = 27
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 27 || !EventIs(r, 303, 0, 0, false) { return 57 }
    // Navigation back to a shallow row reveals it on both axes.
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationHome
    p.horizontal_offset = 99
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 8 || r.scroll_offset != 0 ||
        !EventIs(r, 101, 0, 0, true) { return 58 }
    p.navigation = cast(TreeViewNavigation)TreeViewNavigationNone
    p.disabled = true
    p.horizontal_offset = 27
    p.horizontal_delta = 100
    p.scroll_delta = 12
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 27 || r.scroll_offset != 0 ||
        !EventIs(r, 303, 0, 0, false) { return 59 }
    EventClick(140.0, 45.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 0, 0, false) { return 60 }
    p.disabled = false
    p.horizontal_delta = 2147483647
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 99 { return 61 }
    p.horizontal_delta = -2147483647
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 0 { return 62 }
    // Resizing clamps existing state; it does not alter structural depth.
    p.horizontal_delta = 0
    p.scroll_delta = 0
    p.horizontal_offset = 99
    p.bounds.width = 300.0
    TreeViewHostBounds(p.bounds)
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 0 || r.horizontal_max_scroll != 0 ||
        items[2].depth != 8 { return 63 }
    p.bounds.width = 1.0
    TreeViewHostBounds(p.bounds)
    r = EventFrame(p, items[:])
    if r.horizontal_offset != 99 || r.horizontal_max_scroll != 241 ||
        !EventIs(r, 303, 0, 0, false) { return 64 }
    // A leaf keeps readable label paint but has no marker hit/toggle.
    p.bounds.width = 150.0
    p.horizontal_offset = 99
    p.scroll_offset = 12
    items[2].leaf = true
    TreeViewHostBounds(p.bounds)
    r = EventFrame(p, items[:])
    if !TreeViewDeepReadable() { return 65 }
    EventClick(65.0, 45.0)
    r = EventFrame(p, items[:])
    if !EventIs(r, 303, 303, 0, false) { return 66 }
    // Per-row named typeface/font styles determine measured content width.
    rules := ActiveStyleRules()
    custom: StyleRule
    custom.selector = StyleDefaultSelector()
    custom.selector.kind = StyleKindTreeViewItem()
    custom.selector.name = 303
    custom.style.fields = cast(u32)StyleField.StyleFontSize | cast(u32)StyleField.StyleTypeface
    custom.style.font_size = 20.0
    custom.style.typeface = "Wide"
    rules.items[rules.count] = custom
    rules.count += 1
    if !InstallStyleRules(rules) { return 71 }
    p.reveal_selected = true
    items[2].leaf = false
    TreeViewHostBounds(p.bounds)
    r = EventFrame(p, items[:])
    // A label too wide for the viewport reveals its start without removing depth.
    if r.horizontal_max_scroll != 162 || r.horizontal_offset != 152 ||
        TreeViewDeepX() != 28 || TreeViewDeepReadable() ||
        !EventIs(r, 303, 0, 0, false) { return 72 }
    rules.count -= 1
    if !InstallStyleRules(rules) { return 73 }
    p.reveal_selected = false
    // Very deep/large inputs saturate without s32 arithmetic overflow.
    items[2].depth = 2147483647
    p.horizontal_offset = 2147483647
    p.horizontal_delta = 2147483647
    r = EventFrame(p, items[:])
    if r.horizontal_max_scroll != 2147483505 ||
        r.horizontal_offset != r.horizontal_max_scroll { return 70 }
    // Shrinking the data clamps manual offset too.
    r = EventFrame(p, items[0:1])
    if r.horizontal_offset != 0 || r.horizontal_max_scroll != 0 { return 67 }
    if TreeViewHostFailed() { return 68 }
    return 0
}
