#import "kryon/drawing_props"
#import "kryon/geometry"

fills: s32;
labels: s32;
failed: bool;
host_bounds: Rectangle;
deep_readable: bool;
deep_x: s32;

#program_export
TreeViewHostBounds :: (bounds: Rectangle) {
    host_bounds = bounds
    deep_readable = false
}

#program_export
TreeViewDeepReadable :: () -> bool { return deep_readable }

#program_export
TreeViewDeepX :: () -> s32 { return deep_x }


#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if font == 20 && typeface == "Wide" { return cast(s32)value.count * 14 }
    if font != 14 || typeface.count != 0 { failed = true }
    return cast(s32)value.count * 7
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font == 20 && typeface == "Wide" { return 20 }
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused radius
    unused segments
    unused color
    if bounds.x < host_bounds.x || bounds.y < host_bounds.y ||
        bounds.x + bounds.width > host_bounds.x + host_bounds.width ||
        bounds.y + bounds.height > host_bounds.y + host_bounds.height { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused radius
    unused segments
    unused width
    unused color
    if bounds.x != host_bounds.x || bounds.y != host_bounds.y ||
        bounds.width != host_bounds.width || bounds.height != host_bounds.height { failed = true }
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused value
    unused x
    unused y
    unused color
    if (font != 14 && font != 20) || clip.x < host_bounds.x || clip.y < host_bounds.y ||
        clip.x + clip.width > host_bounds.x + host_bounds.width ||
        clip.y + clip.height > host_bounds.y + host_bounds.height { failed = true }
    if value == "DeepEight" {
        deep_x = x
        text_width: s32 = 63
        if font == 20 { text_width = 126 }
        deep_readable = cast(float32)x >= clip.x &&
            cast(float32)(x + text_width) <= clip.x + clip.width &&
            cast(float32)y >= host_bounds.y && clip.height > 0.0
    }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
TreeViewHostFailed :: () -> bool { return failed }

#program_export
TreeViewLabelCount :: () -> s32 { return labels }

#program_export
TreeViewFillCount :: () -> s32 { return fills }

// These tests do not request rotated labels.
// Fail visibly if future widget behavior begins exercising this operation.
#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle, origin: Vector2, rotation: float32,
    outer_clip: Rectangle, outer_clipped: bool, emphasis: bool, italic: bool) {
    failed = true
}
